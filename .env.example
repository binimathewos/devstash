# Neon PostgreSQL connection string (development branch).
# Get this from the Neon console → your project → branch → Connection string.
# Use the POOLED connection string for the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Optional: direct (non-pooled) connection, recommended by Neon for running
# migrations. If set, point prisma.config.ts at it for `migrate` commands.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Resend API key — used to send transactional email (e.g. email verification).
RESEND_API_KEY="re_..."

# Absolute base URL used to build links in outgoing emails. Use your deployed
# origin in production (e.g. https://devstash.app); localhost in dev.
AUTH_URL="http://localhost:3000"

# Sender address for transactional email. Resend's onboarding@resend.dev works
# without a verified domain in dev; use a verified-domain sender in production.
EMAIL_FROM="DevStash <onboarding@resend.dev>"

# Require email verification before email/password users can sign in. Defaults
# to OFF when unset (until a sending domain is linked to Resend, the link can
# only reach the Resend account owner). Set to "true" to require verification.
EMAIL_VERIFICATION_ENABLED="false"
